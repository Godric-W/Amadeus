# Amadeus example configuration.
#
# Copy this file to <amadeus-root>/config.yaml, or load it explicitly with:
#   amadeus config check --config ./configs/config.yaml.example
#
# All Provider entries are user-defined. Keep credentials out of this file and
# inject the selected Provider key with AMADEUS_API_KEY when possible.
# AMADEUS_MODEL_PROVIDER selects an alias from model_providers, while
# AMADEUS_MODEL selects the model independently of its transport configuration.

model: your-model
model_provider: openai
model_context_window: 128000
# Model capabilities are explicit and independent of the Provider transport.
# Add image only when the selected model actually accepts image input.
model_input_modalities: [text]
# Enable only for models that explicitly support original image detail.
model_supports_original_image_detail: false
# Omit to use the Provider/model default. Supported configured values:
# none, minimal, low, medium, high, xhigh, max.
# model_reasoning_effort: high
# Omit to derive 90% of model_context_window. An explicit value may only
# tighten that threshold.
# model_auto_compact_token_limit: 115200
# Limits only Tool/Function Output projected into model context.
tool_output_token_limit: 10000

model_providers:
  openai:
    wire_api: responses
    dialect: openai
    api_key: ""
    base_url: https://api.openai.com/v1
    timeout: 120s
    request_max_retries: 4
    stream_max_retries: 5
    stream_idle_timeout: 5m

  compatible:
    wire_api: chat_completions
    dialect: standard
    api_key: ""
    base_url: https://example.invalid/v1
    timeout: 120s
    request_max_retries: 4
    stream_max_retries: 5
    stream_idle_timeout: 5m

agent:
  # Parallel-capable tools may overlap up to this limit. Stateful or
  # side-effecting tools still execute serially through their Tool contract.
  max_parallel_tools: 4
  multi_agent:
    # Basic Codex-style delegation to read-only explorer subagents.
    enabled: true
    max_agents: 4
    # The first implementation supports direct children only.
    max_depth: 1
    child_max_samples: 20
    child_max_tool_calls: 100
    child_max_duration: 15m

# Web tools are conditional: disabled capabilities are not registered and are
# therefore invisible to the model.
web:
  fetch:
    enabled: false
    timeout: 30s
    max_bytes: 1048576
    # Set to 0 to reject redirects; the default allows at most 3.
    max_redirects: 3
  search:
    enabled: false
    # Supported providers: duckduckgo, tavily, searxng, brave.
    provider: duckduckgo
    # DuckDuckGo is keyless. For Tavily and Brave, prefer environment expansion
    # instead of storing credentials here.
    api_key: ""
    # Usually empty except for a selected SearXNG instance.
    base_url: ""
    timeout: 15s
    max_results: 5

logging:
  level: info
  trace_llm: false
